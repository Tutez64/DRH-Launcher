import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    AppLineEdit,
    CompactCheck,
    CompactMetricBlock,
    DiscreteSlider,
    EqualColumnFlow,
    GameSessionButton,
    GitHubButton,
    MenuButton,
    HomeDiscordButton,
    HomeNoticeCard,
    HomePlayerCount,
    InfoHint,
    LaunchOptionToggle,
    LaunchTextField,
    LinkButton,
    MarkdownBlock,
    ModAuthor,
    ModCard,
    ModRow,
    ModTag,
    ModTagView,
    NavButton,
    NumericTextField,
    PrimaryButton,
    SecondaryButton,
    SegmentedButton,
    SettingsCard,
    SmallLabel,
    StepperButton,
    TabButton,
    VersionEntryButton,
} from "components.slint";
import "../assets/fonts/Hack-Regular.ttf";

export struct LaunchOptionView {
    name: string,
    flag: string,
    checked: bool,
}

export struct LogLineView {
    text: string,
    color: brush,
    continuation: bool,
}

export struct GameSessionView {
    id: string,
    title: string,
    detail: string,
}

export struct VersionEntryView {
    title: string,
    detail: string,
    status: string,
}

export struct ModCardView {
    name: string,
    version: string,
    summary: string,
    author: string,
    owner: string,
    uses: ModTagView,
    tags: [ModTagView],
    status: string,
    enabled: bool,
    orderable: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct MarkdownBlockView {
    text: styled-text,
    kind: int,
    target: string,
}

component LogViewer inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <bool> show-display-settings: false;
    in property <bool> hide-haxe-iteratee-log-lines: true;
    in property <[LogLineView]> lines;
    in property <bool> default-scroll-to-end;
    in property <bool> saved-position-known;
    in property <length> saved-content-y;
    in property <bool> saved-at-end;
    in property <int> position-key;
    callback wrap-columns-measured(int);
    callback content-position-changed(length, bool);
    callback copy-requested(int, int, int, int) -> string;
    callback set-hide-haxe-iteratee-log-lines(bool);
    property <bool> display-settings-open: false;
    property <int> reported-wrap-columns: 0;
    property <bool> restoring-position: true;
    property <int> stable-restore-ticks: 0;
    property <length> last-restore-target: 1px;
    property <length> current-content-y: log-list.content-y;
    property <length> line-height: 20px;
    property <length> content-height: root.lines.length * root.line-height;
    property <length> end-content-y: min(0px, log-list.visible-height - root.content-height);
    property <bool> at-end: log-list.content-y <= root.end-content-y + 1px;
    property <length> char-width: character-measurement.preferred-width / 64;
    property <int> sel-anchor-line: 0;
    property <int> sel-anchor-col: 0;
    property <int> sel-cursor-line: 0;
    property <int> sel-cursor-col: 0;
    property <bool> selection-forward: root.sel-anchor-line < root.sel-cursor-line || (root.sel-anchor-line == root.sel-cursor-line && root.sel-anchor-col <= root.sel-cursor-col);
    property <int> sel-start-line: root.selection-forward ? root.sel-anchor-line : root.sel-cursor-line;
    property <int> sel-start-col: root.selection-forward ? root.sel-anchor-col : root.sel-cursor-col;
    property <int> sel-end-line: root.selection-forward ? root.sel-cursor-line : root.sel-anchor-line;
    property <int> sel-end-col: root.selection-forward ? root.sel-cursor-col : root.sel-anchor-col;
    property <bool> has-selection: root.sel-start-line != root.sel-end-line || root.sel-start-col != root.sel-end-col;
    property <bool> selecting: false;
    property <bool> menu-open: false;
    property <length> pointer-x: 0px;
    property <length> pointer-y: 0px;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-muted;
    background: Theme.panel-background;

    changed position-key => {
        root.restoring-position = true;
        root.stable-restore-ticks = 0;
        root.selecting = false;
        root.menu-open = false;
        root.display-settings-open = false;
        root.clear-selection();
    }

    changed lines => {
        root.restoring-position = true;
        root.stable-restore-ticks = 0;
        root.selecting = false;
        root.menu-open = false;
        root.clear-selection();
    }

    changed current-content-y => {
        if (!root.restoring-position) {
            root.content-position-changed(root.current-content-y, root.at-end);
        }
        if (root.selecting) {
            root.apply-pointer-selection();
        }
    }

    function line-length(index: int) -> int {
        if (index < 0 || index >= root.lines.length) {
            return 0;
        }
        return root.lines[index].text.character-count;
    }

    function col-at(x: length, line-index: int) -> int {
        if (root.char-width <= 0px) {
            return 0;
        }
        return min(root.line-length(line-index), max(0, floor(x / root.char-width)));
    }

    function line-at-y(y: length) -> int {
        if (root.lines.length == 0) {
            return 0;
        }
        return min(root.lines.length - 1, max(0, floor((-log-list.content-y + y) / root.line-height)));
    }

    function apply-pointer-selection() {
        if (root.lines.length == 0) {
            return;
        }
        let y = min(max(0px, log-list.visible-height - 1px), max(0px, root.pointer-y));
        let current = root.line-at-y(y);
        root.sel-cursor-line = current;
        root.sel-cursor-col = root.col-at(root.pointer-x, current);
    }

    function show-log-menu() {
        if (root.menu-open) {
            log-context-menu.close();
            root.menu-open = false;
            return;
        }
        log-focus.focus();
        log-context-menu.show({
            x: round((log-pointer.absolute-position.x - log-context-menu.absolute-position.x + root.pointer-x) / 1px) * 1px,
            y: round((log-pointer.absolute-position.y - log-context-menu.absolute-position.y + root.pointer-y) / 1px) * 1px,
        });
        root.menu-open = true;
    }

    function line-has-selection(index: int) -> bool {
        return root.has-selection && index >= root.sel-start-line && index <= root.sel-end-line;
    }

    function line-sel-x(index: int) -> length {
        if (index != root.sel-start-line) {
            return 0px;
        }
        return root.sel-start-col * root.char-width;
    }

    function line-sel-width(index: int, row-width: length) -> length {
        if (index == root.sel-start-line && index == root.sel-end-line) {
            return max(0, root.sel-end-col - root.sel-start-col) * root.char-width;
        }
        if (index == root.sel-start-line) {
            return max(0px, row-width - root.sel-start-col * root.char-width);
        }
        if (index == root.sel-end-line) {
            return root.sel-end-col * root.char-width;
        }
        return row-width;
    }

    function clear-selection() {
        root.sel-anchor-line = 0;
        root.sel-anchor-col = 0;
        root.sel-cursor-line = 0;
        root.sel-cursor-col = 0;
    }

    function select-all-text() {
        root.sel-anchor-line = 0;
        root.sel-anchor-col = 0;
        root.sel-cursor-line = max(0, root.lines.length - 1);
        root.sel-cursor-col = root.line-length(root.sel-cursor-line);
        log-focus.focus();
    }

    function copy-current-selection() {
        if (root.lines.length == 0) {
            return;
        }
        clipboard-helper.text = root.has-selection
            ? root.copy-requested(root.sel-start-line, root.sel-start-col, root.sel-end-line, root.sel-end-col)
            : root.copy-requested(0, 0, root.lines.length - 1, root.line-length(root.lines.length - 1));
        clipboard-helper.select-all();
        clipboard-helper.copy();
    }

    character-measurement := Text {
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: "Hack";
        font-size: 13px;
        visible: false;
    }

    clipboard-helper := TextInput {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        visible: false;
        read-only: true;
    }

    log-context-menu := ContextMenuArea {
        width: 100%;
        height: 100%;

        Menu {
            MenuItem {
                title: "Copy";
                enabled: root.lines.length > 0;
                activated => {
                    root.menu-open = false;
                    root.copy-current-selection();
                }
            }

            MenuItem {
                title: "Select All";
                enabled: root.lines.length > 0;
                activated => {
                    root.menu-open = false;
                    root.select-all-text();
                }
            }
        }

        log-focus := FocusScope {
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if ((event.modifiers.control || event.modifiers.meta) && event.text == "c") {
                    if (root.has-selection) {
                        root.copy-current-selection();
                    }
                    return accept;
                }
                if ((event.modifiers.control || event.modifiers.meta) && event.text == "a") {
                    root.select-all-text();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    if (root.display-settings-open) {
                        root.display-settings-open = false;
                        return accept;
                    }
                    root.clear-selection();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.title;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        vertical-alignment: center;
                    }

                    if root.show-display-settings : display-settings-button := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.display-settings-open || settings-touch.has-hover ? Theme.accent-warm : Theme.border-accent-muted;
                        background: root.display-settings-open ? Theme.surface-selected : settings-touch.pressed ? Theme.surface-pressed : settings-touch.has-hover ? Theme.surface-accent : Theme.surface-raised;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("icons/settings.svg");
                            image-fit: contain;
                        }

                        settings-touch := TouchArea {
                            clicked => {
                                root.display-settings-open = !root.display-settings-open;
                            }
                        }
                    }
                }

                log-pane := Rectangle {
                    min-width: 0px;
                    vertical-stretch: 1;
                    clip: true;

                    log-list := ListView {
                        width: 100%;
                        height: 100%;
                        opacity: root.reported-wrap-columns > 0 && !root.restoring-position ? 1 : 0;

                        for line[index] in root.lines: Rectangle {
                            height: root.line-height;
                            clip: true;

                            Rectangle {
                                x: root.line-sel-x(index);
                                width: root.line-sel-width(index, parent.width);
                                height: parent.height;
                                background: #8a3a2e99;
                                visible: root.line-has-selection(index);
                            }

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: line.text;
                                font-family: "Hack";
                                font-size: 13px;
                                color: line.color;
                                wrap: no-wrap;
                                overflow: clip;
                                vertical-alignment: center;
                            }
                        }
                    }

                    log-pointer := TouchArea {
                        x: 0px;
                        width: max(0px, parent.width - 14px);
                        height: 100%;
                        mouse-cursor: text;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.cancel) {
                                root.selecting = false;
                                return;
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                log-focus.focus();
                                root.menu-open = false;
                                root.pointer-x = self.mouse-x;
                                root.pointer-y = self.mouse-y;
                                root.selecting = true;
                                if (!event.modifiers.shift) {
                                    let line = root.line-at-y(self.mouse-y);
                                    root.sel-anchor-line = line;
                                    root.sel-anchor-col = root.col-at(self.mouse-x, line);
                                }
                                root.apply-pointer-selection();
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                root.selecting = false;
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.pointer-x = self.mouse-x;
                                root.pointer-y = self.mouse-y;
                                root.show-log-menu();
                            }
                        }
                        moved => {
                            root.pointer-x = self.mouse-x;
                            root.pointer-y = self.mouse-y;
                            if (root.selecting) {
                                root.apply-pointer-selection();
                            }
                        }
                        double-clicked => {
                            let line = root.line-at-y(self.mouse-y);
                            root.sel-anchor-line = line;
                            root.sel-anchor-col = 0;
                            root.sel-cursor-line = line;
                            root.sel-cursor-col = root.line-length(line);
                            log-focus.focus();
                        }
                        scroll-event(event) => {
                            if (root.selecting) {
                                log-list.content-y = min(0px, max(root.end-content-y, log-list.content-y + event.delta-y));
                                root.apply-pointer-selection();
                                return accept;
                            }
                            return reject;
                        }
                    }

                    select-auto-scroll := Timer {
                        interval: 16ms;
                        running: root.selecting;

                        triggered => {
                            if (root.pointer-y < 0px) {
                                let step = max(4px, min(72px, -root.pointer-y / 3));
                                log-list.content-y = min(0px, log-list.content-y + step);
                            } else if (root.pointer-y > log-list.visible-height) {
                                let step = max(4px, min(72px, (root.pointer-y - log-list.visible-height) / 3));
                                log-list.content-y = max(root.end-content-y, log-list.content-y - step);
                            }
                            root.apply-pointer-selection();
                        }
                    }
                }

                if root.meta != "" : Text {
                    text: root.meta;
                    color: Theme.text-support;
                    font-size: 12px;
                    font-weight: 600;
                }

                restore-scroll-position := Timer {
                    interval: 16ms;
                    running: root.restoring-position;

                    triggered => {
                        if (log-list.visible-width <= 0px || log-list.visible-height <= 0px) {
                            root.stable-restore-ticks += 1;
                            if (root.stable-restore-ticks >= 15) {
                                root.restoring-position = false;
                            }
                            return;
                        }

                        let target = root.saved-position-known
                            ? root.saved-at-end ? root.end-content-y : root.saved-content-y
                            : root.default-scroll-to-end ? root.end-content-y : 0px;
                        log-list.content-y = target;

                        if (target == root.last-restore-target && log-list.content-y == target) {
                            root.stable-restore-ticks += 1;
                        } else {
                            root.last-restore-target = target;
                            root.stable-restore-ticks = 0;
                        }

                        if (root.stable-restore-ticks >= 3) {
                            root.restoring-position = false;
                            root.content-position-changed(log-list.content-y, root.at-end);
                        }
                    }
                }

                report-wrap-columns := Timer {
                    interval: 100ms;
                    running: true;

                    triggered => {
                        let character-width-px = character-measurement.preferred-width / 64px;
                        if (character-width-px > 0) {
                            let columns = max(
                                20,
                                floor(log-list.visible-width / 1px / character-width-px),
                            );
                            if (columns != root.reported-wrap-columns) {
                                root.reported-wrap-columns = columns;
                                root.wrap-columns-measured(root.reported-wrap-columns);
                            }
                        }
                    }
                }
            }

            if root.display-settings-open : TouchArea {
                z: 5;
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                clicked => {
                    root.display-settings-open = false;
                }
            }

            if root.display-settings-open : Rectangle {
                z: 10;
                x: max(12px, parent.width - self.width - 12px);
                y: 44px;
                width: min(320px, parent.width - 24px);
                height: display-settings-content.preferred-height;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.border-accent-muted;
                background: Theme.surface-raised;
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: Theme.shadow-strong;

                TouchArea {}

                display-settings-content := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    CompactCheck {
                        text: "Hide Haxe warnings";
                        checked: root.hide-haxe-iteratee-log-lines;
                        toggled(checked) => {
                            root.set-hide-haxe-iteratee-log-lines(checked);
                        }
                    }

                    Text {
                        text: "DRH prints a Haxe iteratee FIXME thousands of times per session. Hidden here by default. The log file is unchanged; Open selected file still shows the raw output.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> install-status;
    in property <string> version-status;
    in property <string> install-action-text;
    in property <bool> install-action-enabled: true;
    in property <string> update-check-text: "Check for updates";
    in property <bool> update-check-enabled: true;
    in property <string> home-support-text;
    in property <string> home-notice-text;
    in property <string> home-notice-detail;
    in property <int> home-notice-count;
    in property <int> home-notice-index;
    in property <bool> home-notice-dismissible;
    in property <bool> home-notice-has-link;
    in property <string> home-notice-link-prefix;
    in property <string> home-notice-link-label;
    in property <string> home-notice-link-suffix;
    in property <string> home-notice-link-url;
    in property <string> steam-players-count;
    in property <string> steam-players-detail;
    in property <[LogLineView]> log-lines;
    in property <[GameSessionView]> game-log-sessions;
    in property <string> game-log-sessions-label: "Game sessions";
    in property <string> game-log-migration-status;
    in property <bool> refresh-logs-enabled: true;
    in property <[VersionEntryView]> drh-version-entries;
    in-out property <int> mods-page: 0;
    in property <string> mods-installed-tab-text: "Installed";
    in property <[ModCardView]> mod-entries;
    in-out property <bool> mod-detail-open: false;
    in property <string> mod-list-empty-text;
    in-out property <string> mod-search;
    in property <bool> mods-busy: false;
    in property <string> mods-error;
    in property <string> mods-run-text;
    in-out property <bool> mods-disclosure-visible: false;
    // Before a first use of mods: Continue goes on with it. Else only read.
    in-out property <bool> mods-disclosure-asking: false;
    in property <bool> mods-run-warning: false;
    in property <bool> mod-confirm-visible: false;
    in property <string> mod-confirm-title;
    in property <string> mod-confirm-text;
    in property <string> mod-confirm-button;
    // Installing a mod from a GitHub link or a zip: what it is doing, or why
    // it could not.
    in-out property <bool> mod-elsewhere-visible: false;
    in-out property <string> mod-elsewhere-link;
    in-out property <string> mod-elsewhere-working;
    in-out property <string> mod-elsewhere-error;
    in property <string> mods-index-status;
    in property <string> selected-mod-title: "No mod selected";
    in property <string> selected-mod-description;
    in property <string> selected-mod-author;
    in property <string> selected-mod-owner;
    in property <bool> selected-mod-folder-visible: false;
    in-out property <length> mod-list-scroll: 0px;
    in-out property <length> mod-detail-scroll: 0px;
    in property <[ModTagView]> selected-mod-tags;
    in property <[MarkdownBlockView]> selected-mod-blocks;
    in property <string> selected-mod-primary-text;
    in property <bool> selected-mod-primary-enabled: false;
    in property <string> selected-mod-update-text;
    in property <bool> selected-mod-uninstall-visible: false;
    in property <bool> selected-mod-repository-enabled: false;
    in property <[VersionEntryView]> launcher-version-entries;
    in property <[MarkdownBlockView]> selected-version-changelog-blocks;
    in property <string> drh-version-list-label: "DRH releases";
    in property <string> launcher-version-list-label: "DRH Launcher releases";
    in-out property <int> launcher-log-wrap-columns: 120;
    in-out property <int> game-log-wrap-columns: 120;
    in-out property <int> log-source: 0;
    in-out property <int> selected-game-log-index: -1;
    in-out property <length> launcher-log-content-y: 0px;
    in-out property <bool> launcher-log-position-known: false;
    in-out property <bool> launcher-log-at-end: false;
    in-out property <length> game-log-content-y: 0px;
    in-out property <bool> game-log-position-known: false;
    in-out property <bool> game-log-at-end: false;
    in property <string> selected-game-log-id;
    in property <string> selected-game-log-title: "No game session selected";
    in property <bool> selected-game-log-enabled: false;
    in property <string> launcher-log-title: "Launcher log";
    in property <string> log-meta;
    in-out property <bool> hide-haxe-iteratee-log-lines: true;
    in property <string> launcher-version;
    in property <bool> launcher-update-visible: false;
    in property <string> launcher-update-status;
    in property <string> launcher-update-action-text: "Update and restart";
    in property <bool> launcher-update-action-enabled: true;
    in property <bool> linux-integration-visible: false;
    in property <bool> linux-integration-advanced: false;
    in property <string> linux-integration-status;
    in property <string> linux-integration-path;
    in property <bool> open-linux-integration-folder-enabled: false;
    in property <string> linux-integration-action-text;
    in property <bool> linux-integration-action-enabled: false;
    in property <string> config-path;
    in property <string> install-folder-path;
    in-out property <string> download-cache-limit;
    in-out property <string> saved-download-cache-limit;
    in-out property <string> download-cache-save-text: "Save";
    in-out property <string> download-cache-limit-error;
    in-out property <bool> hide-official-ownership-notice: false;
    in-out property <bool> saved-hide-official-ownership-notice: false;
    property <bool> download-cache-limit-dirty: root.download-cache-limit != root.saved-download-cache-limit;
    property <bool> ownership-notice-dirty: root.hide-official-ownership-notice != root.saved-hide-official-ownership-notice;
    property <bool> general-settings-dirty: root.download-cache-limit-dirty || root.ownership-notice-dirty;
    in-out property <string> pre-launch-command;
    in property <bool> frame-rate-controls-visible: false;
    in property <bool> frame-rate-supported: false;
    in-out property <int> frame-rate-mode: 0;
    in-out property <int> saved-frame-rate-mode: 0;
    in-out property <string> game-frame-rate;
    in-out property <string> saved-game-frame-rate;
    in-out property <string> game-frame-rate-error;
    in property <string> frame-rate-notice;
    in property <[int]> frame-rate-presets;
    in-out property <float> frame-rate-preset-index: 0;
    in property <float> frame-rate-preset-maximum: 1;
    in-out property <int> launch-arguments-mode: 1;
    in-out property <string> custom-game-args;
    in-out property <string> saved-pre-launch-command;
    in-out property <int> saved-launch-arguments-mode: 1;
    in-out property <string> saved-custom-game-args;
    in-out property <string> launch-options-save-text: "Save";
    in property <string> launch-options-empty-text: "No known launch options loaded from the release manifest.";
    in property <bool> launch-argument-controls-visible: false;
    in property <bool> launch-argument-modes-enabled: false;
    in property <[LaunchOptionView]> launch-options;
    in-out property <string> launch-options-state;
    in-out property <string> saved-launch-options-state;
    property <bool> launch-options-dirty: root.pre-launch-command != root.saved-pre-launch-command
        || root.frame-rate-mode != root.saved-frame-rate-mode
        || root.game-frame-rate != root.saved-game-frame-rate
        || root.launch-arguments-mode != root.saved-launch-arguments-mode
        || root.launch-options-state != root.saved-launch-options-state
        || root.custom-game-args != root.saved-custom-game-args;
    in property <bool> open-install-folder-enabled: false;
    in property <bool> open-logs-folder-enabled: false;
    in property <bool> restore-previous-enabled: false;
    in property <string> restore-previous-text: "Restore previous";
    in property <bool> reinstall-current-enabled: false;
    in property <string> reinstall-current-text: "Reinstall current";
    in-out property <int> active-page: 0;
    in-out property <int> version-history-page: 0;
    in-out property <int> selected-drh-version-index: -1;
    in-out property <int> selected-launcher-version-index: -1;
    in property <string> version-history-status;
    in property <bool> version-history-loading: false;
    in property <bool> refresh-version-history-enabled: true;
    in property <string> selected-version-title: "No release selected";
    in property <string> selected-version-detail;
    in property <bool> selected-version-release-enabled: false;
    in property <string> selected-version-action-text: "Install selected version";
    in property <bool> selected-version-action-enabled: false;
    in property <bool> selected-version-replace-confirmation-visible: false;
    in property <string> selected-version-replace-confirmation-text: "";
    in-out property <length> selected-version-replace-popover-anchor-x: 0px;
    in-out property <length> selected-version-replace-popover-anchor-y: 0px;
    in-out property <int> settings-page: 0;
    in-out property <bool> advanced-settings-open: false;
    in-out property <bool> help-menu-open: false;
    in-out property <bool> more-mods-open: false;
    in-out property <bool> close-confirmation-visible: false;
    in-out property <bool> close-confirmation-busy: false;
    in-out property <string> close-confirmation-error;
    in-out property <bool> appimage-dialog-visible: false;
    in-out property <int> appimage-dialog-mode: 1;
    in-out property <bool> appimage-dialog-busy: false;
    in-out property <string> appimage-dialog-error;
    property <bool> info-tooltip-visible: false;
    property <string> info-tooltip-text;
    property <length> info-tooltip-width: 390px;
    property <length> info-tooltip-anchor-x: 0px;
    property <length> info-tooltip-anchor-y: 0px;
    property <bool> info-tooltip-place-left: false;
    property <bool> info-tooltip-place-above: false;

    callback install-or-play();
    callback check-updates();
    callback open-config-folder();
    callback open-install-folder();
    callback open-logs-folder();
    callback open-selected-game-log();
    callback open-discord-link();
    callback open-drh-github-link();
    callback open-drhl-github-link();
    callback open-ax4-github-link();
    callback launcher-update-action();
    callback linux-integration-action();
    callback open-linux-integration-folder();
    callback cancel-appimage-dialog();
    callback confirm-appimage-action();
    callback refresh-logs();
    callback ensure-logs();
    callback ensure-version-history();
    callback ensure-mods();
    callback select-mods-page(int);
    callback select-mod(int);
    callback mod-search-edited(string);
    callback mod-primary-action();
    callback mod-update();
    callback mod-uninstall();
    callback open-mod-folder();
    callback mod-confirm-accepted();
    callback mod-confirm-cancelled();
    callback dismiss-mods-error();
    callback mods-disclosure-continue();
    callback mods-disclosure-close();
    callback mod-install-from-link(string);
    callback mod-install-from-zip();
    callback mod-elsewhere-cancelled();
    // The mod a link or zip gave, or its error, is ready.
    callback mod-elsewhere-ready();
    callback open-mod-guide();
    callback toggle-mod(int);

    function show-mod-tooltip(text: string, x: length, y: length) {
        root.info-tooltip-text = text;
        root.info-tooltip-width = 380px;
        root.info-tooltip-anchor-x = x;
        root.info-tooltip-anchor-y = y;
        root.info-tooltip-place-left = false;
        root.info-tooltip-place-above = true;
        root.info-tooltip-visible = true;
    }
    callback move-mod(int, int);
    callback open-mod-repository();
    callback refresh-mods();
    callback open-mods-folder();
    callback refresh-version-history();
    callback select-version-history-source(int);
    callback select-drh-version(int);
    callback select-launcher-version(int);
    callback open-selected-version-release();
    callback open-markdown-link(string);
    callback install-selected-drh-version();
    callback cancel-selected-drh-version-install();
    callback select-log-source(int);
    callback select-game-log(int);
    callback set-hide-haxe-iteratee-log-lines(bool);
    callback log-wrap-columns-measured(int, int);
    callback copy-log-selection(int, int, int, int) -> string;
    callback increment-download-cache-limit();
    callback decrement-download-cache-limit();
    callback save-general-settings();
    callback cancel-general-settings();
    callback restore-previous-version();
    callback reinstall-current-version();
    callback select-frame-rate-mode(int);
    callback select-frame-rate-preset(float);
    callback save-launch-options();
    callback select-launch-arguments-mode(int);
    callback toggle-launch-option(int, bool);
    callback cancel-launch-options();
    callback cancel-close();
    callback confirm-close();
    callback select-home-notice(int);
    callback dismiss-home-notice();
    callback open-home-notice-link(string);

    changed download-cache-limit => {
        root.download-cache-limit-error = "";
    }

    changed game-frame-rate => {
        root.game-frame-rate-error = "";
    }

    changed active-page => {
        root.help-menu-open = false;
        root.more-mods-open = false;
        root.info-tooltip-visible = false;
        if root.active-page == 4 && root.settings-page == 1 {
            root.ensure-logs();
        }
    }

    changed settings-page => {
        if root.active-page == 4 && root.settings-page == 1 {
            root.ensure-logs();
        }
    }

    title: "DRH Launcher";
    icon: @image-url("../assets/icons/app-icon-256.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.app-background;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            width: 188px;
            background: Theme.sidebar-background;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: "DRH Launcher";
                        color: Theme.text-title;
                        font-size: 15px;
                        font-weight: 800;
                    }

                    Text {
                        text: "Dungeon Rampage Haxe";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: 12px;
                }

                NavButton {
                    text: "Home";
                    active: root.active-page == 0;
                    clicked => {
                        root.help-menu-open = false;
                        root.active-page = 0;
                    }
                }

                NavButton {
                    text: "Options";
                    active: root.active-page == 1;
                    clicked => {
                        root.help-menu-open = false;
                        root.active-page = 1;
                    }
                }

                NavButton {
                    text: "Versions";
                    active: root.active-page == 2;
                    clicked => {
                        root.help-menu-open = false;
                        root.active-page = 2;
                        root.ensure-version-history();
                    }
                }

                NavButton {
                    text: "Mods";
                    active: root.active-page == 3;
                    clicked => {
                        root.help-menu-open = false;
                        root.active-page = 3;
                        root.ensure-mods();
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                NavButton {
                    text: "Settings";
                    active: root.active-page == 4;
                    clicked => {
                        root.help-menu-open = false;
                        root.active-page = 4;
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.divider;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.app-background;

            VerticalLayout {
                padding: 26px;
                spacing: 18px;

                if root.active-page == 0 : Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: transparent;

                    home-background := Rectangle {
                        x: -26px;
                        y: -26px;
                        width: parent.width + 52px;
                        height: parent.height + 52px;
                        clip: true;
                        background: Theme.home-background;

                        Rectangle {
                            width: 520px;
                            height: 520px;
                            x: parent.width - 390px;
                            y: -210px;
                            border-radius: 260px;
                            background: Theme.home-glow-warm;
                        }

                        Rectangle {
                            width: 470px;
                            height: 470px;
                            x: -190px;
                            y: parent.height - 290px;
                            border-radius: 235px;
                            background: Theme.home-glow-hot;
                        }
                    }

                    if root.help-menu-open : TouchArea {
                        z: 10;
                        clicked => {
                            root.help-menu-open = false;
                        }
                    }

                    home-panel := Rectangle {
                        width: min(760px, parent.width - 16px);
                        height: min(378px, parent.height - 16px);
                        x: round((parent.width - self.width) / 2 / 1px) * 1px;
                        y: round((parent.height - self.height) / 2 / 1px) * 1px;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: Theme.home-panel-background;
                        drop-shadow-blur: 22px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: Theme.shadow-strong;

                        // Clip overflowing decorations only. clip + border-radius
                        // rasterizes children into a texture, which blurs text.
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            clip: true;
                            border-radius: 10px;

                            Rectangle {
                                width: 310px;
                                height: 310px;
                                x: parent.width - 205px;
                                y: -135px;
                                border-radius: 155px;
                                border-width: 1px;
                                border-color: Theme.home-panel-ring;
                                background: Theme.home-panel-decoration;
                            }

                            Rectangle {
                                width: 210px;
                                height: 210px;
                                x: parent.width - 105px;
                                y: parent.height - 88px;
                                border-radius: 105px;
                                border-width: 1px;
                                border-color: Theme.home-panel-ring;
                                background: transparent;
                            }

                            Rectangle {
                                width: parent.width - 48px;
                                height: 2px;
                                x: 24px;
                                background: Theme.home-panel-sheen;
                            }
                        }

                        VerticalLayout {
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 28px;
                            padding-bottom: 26px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 16px;

                                Rectangle {
                                    width: 76px;
                                    height: 76px;
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: Theme.home-icon-border;
                                    background: Theme.home-icon-background;
                                    clip: true;

                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: @image-url("../assets/icons/drh-icon-256.png");
                                        image-fit: cover;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;

                                    Text {
                                        text: "DUNGEON RAMPAGE HAXE";
                                        color: Theme.accent-warm;
                                        font-size: 11px;
                                        font-weight: 800;
                                        letter-spacing: 1px;
                                    }

                                    Text {
                                        text: root.install-status;
                                        color: Theme.text-title;
                                        font-size: 22px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.version-status;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }

                                Rectangle {
                                    width: 116px;

                                    VerticalLayout {
                                        y: round((parent.height - self.preferred-height) / 2 / 1px) * 1px;
                                        width: parent.width;
                                        spacing: 4px;

                                        HomeDiscordButton {
                                            clicked => {
                                                root.open-discord-link();
                                            }
                                        }

                                        if root.steam-players-count != "" : HomePlayerCount {
                                            count: root.steam-players-count;
                                            detail: root.steam-players-detail;
                                            show-tooltip(text, x, y) => {
                                                root.info-tooltip-text = text;
                                                root.info-tooltip-width = 560px;
                                                root.info-tooltip-anchor-x = x;
                                                root.info-tooltip-anchor-y = y;
                                                root.info-tooltip-place-left = true;
                                                root.info-tooltip-place-above = false;
                                                root.info-tooltip-visible = true;
                                            }
                                            hide-tooltip => {
                                                root.info-tooltip-visible = false;
                                            }
                                        }
                                    }
                                }
                            }

                            home-title-divider := Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }

                            play-cluster := VerticalLayout {
                                width: 100%;
                                padding-top: 8px;
                                spacing: 16px;

                                play-row := HorizontalLayout {
                                    alignment: center;

                                    PrimaryButton {
                                        width: 218px;
                                        height: 52px;
                                        text: root.install-action-text;
                                        enabled: root.install-action-enabled;
                                        clicked => {
                                            root.install-or-play();
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    alignment: center;

                                    Rectangle {
                                        width: min(560px, home-panel.width - 60px);
                                        min-height: 42px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border-muted;
                                        background: Theme.home-status-background;

                                        Text {
                                            x: 14px;
                                            width: parent.width - 28px;
                                            height: 100%;
                                            text: root.home-support-text;
                                            font-size: 12px;
                                            color: Theme.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }

                            home-action-row := HorizontalLayout {
                                spacing: 10px;

                                SecondaryButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: root.update-check-text;
                                    enabled: root.update-check-enabled;
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.check-updates();
                                    }
                                }

                                SecondaryButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: "Options";
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.active-page = 1;
                                    }
                                }

                                MenuButton {
                                    text: "Help";
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    active: root.help-menu-open;
                                    clicked => {
                                        root.help-menu-open = !root.help-menu-open;
                                    }
                                }
                            }
                        }

                        if root.home-notice-text != "" : HomeNoticeCard {
                            x: round((parent.width - self.width) / 2 / 1px) * 1px;
                            y: round((home-title-divider.y + home-title-divider.height + (play-cluster.y + play-row.y - home-title-divider.y - home-title-divider.height - self.height) / 2) / 1px) * 1px;
                            width: min(560px, parent.width - 60px);
                            z: 1;
                            text: root.home-notice-text;
                            detail: root.home-notice-detail;
                            count: root.home-notice-count;
                            index: root.home-notice-index;
                            dismissible: root.home-notice-dismissible;
                            has-link: root.home-notice-has-link;
                            link-prefix: root.home-notice-link-prefix;
                            link-label: root.home-notice-link-label;
                            link-suffix: root.home-notice-link-suffix;
                            link-url: root.home-notice-link-url;
                            select(index) => {
                                root.select-home-notice(index);
                            }
                            dismiss => {
                                root.dismiss-home-notice();
                            }
                            open-link(url) => {
                                root.open-home-notice-link(url);
                            }
                            show-tooltip(text, x, y) => {
                                root.info-tooltip-text = text;
                                root.info-tooltip-width = 450px;
                                root.info-tooltip-anchor-x = x;
                                root.info-tooltip-anchor-y = y;
                                root.info-tooltip-place-left = false;
                                root.info-tooltip-place-above = true;
                                root.info-tooltip-visible = true;
                            }
                            hide-tooltip => {
                                root.info-tooltip-visible = false;
                            }
                        }

                    }

                    if root.launcher-update-visible : Rectangle {
                        z: 5;
                        width: min(560px, parent.width - 16px);
                        height: 58px;
                        x: round((parent.width - self.width) / 2 / 1px) * 1px;
                        y: 8px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.border-accent;
                        background: Theme.surface-raised;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow-strong;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;

                            Text {
                                horizontal-stretch: 1;
                                text: root.launcher-update-status;
                                font-size: 13px;
                                color: Theme.text-body;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }

                            SecondaryButton {
                                text: root.launcher-update-action-text;
                                enabled: root.launcher-update-action-enabled;
                                clicked => {
                                    root.launcher-update-action();
                                }
                            }
                        }
                    }

                    if root.help-menu-open : Rectangle {
                        z: 20;
                        width: min(500px, home-panel.width - 32px);
                        height: 104px;
                        x: round((home-panel.x + home-panel.width - self.width - 30px) / 1px) * 1px;
                        y: round((home-panel.y + home-panel.height - self.height - 78px) / 1px) * 1px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: Theme.border-accent-muted;
                        background: Theme.surface-raised;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow-strong;

                        TouchArea {}

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 38px;
                                spacing: 10px;

                                SecondaryButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: root.restore-previous-text;
                                    enabled: root.restore-previous-enabled;
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.restore-previous-version();
                                    }
                                }

                                SecondaryButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: root.reinstall-current-text;
                                    enabled: root.reinstall-current-enabled;
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.reinstall-current-version();
                                    }
                                }

                                SecondaryButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: "Open logs";
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.active-page = 4;
                                        root.settings-page = 1;
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 38px;
                                spacing: 10px;

                                GitHubButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: "DRH GitHub";
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.open-drh-github-link();
                                    }
                                }

                                GitHubButton {
                                    min-width: 112px;
                                    horizontal-stretch: 1;
                                    text: "DRHL GitHub";
                                    clicked => {
                                        root.help-menu-open = false;
                                        root.open-drhl-github-link();
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active-page == 1 : Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 16px;

                        options-page-scroll := ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: options-page-content.preferred-height;

                            options-page-content := VerticalLayout {
                                width: options-page-scroll.width;
                                spacing: 12px;

                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        z: 10;
                                        spacing: 8px;
                                        alignment: start;

                                        SmallLabel {
                                            label: "Frame rate";
                                        }

                                        InfoHint {
                                            text: "The original Dungeon Rampage mostly runs at 24 FPS, even if counters show 60.\nHigher rates make DRH smoother, but excessive values may reduce performance or slow the game down.";
                                            show-tooltip(text, x, y) => {
                                                root.info-tooltip-text = text;
                                                root.info-tooltip-width = 615px;
                                                root.info-tooltip-anchor-x = x;
                                                root.info-tooltip-anchor-y = y;
                                                root.info-tooltip-place-left = false;
                                                root.info-tooltip-place-above = false;
                                                root.info-tooltip-visible = true;
                                            }
                                            hide-tooltip => {
                                                root.info-tooltip-visible = false;
                                            }
                                        }
                                    }

                                    if root.frame-rate-controls-visible : HorizontalLayout {
                                        spacing: 0px;

                                        SegmentedButton {
                                            text: "Auto";
                                            active: root.frame-rate-mode == 0;
                                            enabled: root.frame-rate-supported;
                                            clicked => {
                                                root.select-frame-rate-mode(0);
                                            }
                                        }

                                        SegmentedButton {
                                            text: "Preset";
                                            active: root.frame-rate-mode == 1;
                                            enabled: root.frame-rate-supported;
                                            clicked => {
                                                root.select-frame-rate-mode(1);
                                            }
                                        }

                                        SegmentedButton {
                                            text: "Custom";
                                            active: root.frame-rate-mode == 2;
                                            enabled: root.frame-rate-supported;
                                            clicked => {
                                                root.select-frame-rate-mode(2);
                                            }
                                        }
                                    }

                                    if root.frame-rate-controls-visible && root.frame-rate-mode != 2 : VerticalLayout {
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 12px;

                                            DiscreteSlider {
                                                horizontal-stretch: 1;
                                                enabled: root.frame-rate-supported && root.frame-rate-mode == 1;
                                                minimum: 0;
                                                maximum: root.frame-rate-preset-maximum;
                                                value: root.frame-rate-preset-index;
                                                changed(value) => {
                                                    root.select-frame-rate-preset(value);
                                                }
                                            }

                                            Text {
                                                min-width: 68px;
                                                text: !root.frame-rate-supported
                                                    ? "Built-in"
                                                    : root.frame-rate-mode == 0 ? "Auto" : root.game-frame-rate + " FPS";
                                                color: root.frame-rate-supported ? Theme.text-primary : Theme.text-disabled;
                                                font-size: 13px;
                                                font-weight: 700;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        if root.frame-rate-supported : HorizontalLayout {
                                            spacing: 12px;

                                            preset-labels := Rectangle {
                                                horizontal-stretch: 1;
                                                height: 16px;

                                                for preset[index] in root.frame-rate-presets: Text {
                                                    width: 48px;
                                                    x: 10px
                                                        + index * (preset-labels.width - 20px) / max(root.frame-rate-presets.length - 1, 1)
                                                        - self.width / 2;
                                                    text: preset;
                                                    color: Theme.text-support;
                                                    font-size: 11px;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                width: 68px;
                                            }
                                        }
                                    }

                                    if root.frame-rate-controls-visible && root.frame-rate-mode == 2 : HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        NumericTextField {
                                            width: 72px;
                                            value <=> root.game-frame-rate;
                                        }

                                        Text {
                                            text: "FPS";
                                            color: Theme.text-body;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.frame-rate-notice;
                                        font-size: 13px;
                                        color: root.frame-rate-mode == 2 ? Theme.accent-warm : Theme.text-support;
                                        wrap: word-wrap;
                                    }

                                    if root.game-frame-rate-error != "" : Text {
                                        text: root.game-frame-rate-error;
                                        font-size: 13px;
                                        color: Theme.accent-primary-hover;
                                        wrap: word-wrap;
                                    }
                                }

                                LaunchTextField {
                                    label: "Pre-launch command";
                                    placeholder: "mangohud, gamescope, prime-run...";
                                    value <=> root.pre-launch-command;
                                }

                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        z: 10;
                                        spacing: 8px;
                                        alignment: start;

                                        SmallLabel {
                                            label: "Arguments";
                                        }

                                        InfoHint {
                                            text: "Original Dungeon Rampage launch options.\nGame defaults: leave them untouched.\nDRHL recommended: use launcher defaults.\nCustom: adjust them manually.";
                                            show-tooltip(text, x, y) => {
                                                root.info-tooltip-text = text;
                                                root.info-tooltip-width = 270px;
                                                root.info-tooltip-place-left = false;
                                                root.info-tooltip-place-above = false;
                                                root.info-tooltip-anchor-x = x;
                                                root.info-tooltip-anchor-y = y;
                                                root.info-tooltip-visible = true;
                                            }
                                            hide-tooltip => {
                                                root.info-tooltip-visible = false;
                                            }
                                        }
                                    }

                                    if root.launch-argument-controls-visible : HorizontalLayout {
                                        spacing: 0px;

                                        SegmentedButton {
                                            text: "Game defaults";
                                            active: root.launch-arguments-mode == 0;
                                            enabled: root.launch-argument-modes-enabled;
                                            clicked => {
                                                root.select-launch-arguments-mode(0);
                                            }
                                        }

                                        SegmentedButton {
                                            text: "DRHL recommended";
                                            active: root.launch-arguments-mode == 1;
                                            enabled: root.launch-argument-modes-enabled;
                                            clicked => {
                                                root.select-launch-arguments-mode(1);
                                            }
                                        }

                                        SegmentedButton {
                                            text: "Custom";
                                            active: root.launch-arguments-mode == 2;
                                            enabled: root.launch-argument-modes-enabled;
                                            clicked => {
                                                root.select-launch-arguments-mode(2);
                                            }
                                        }
                                    }

                                    if root.launch-argument-controls-visible && root.launch-options.length > 0 : launch-option-flow := EqualColumnFlow {
                                        cell-min-width: launch-option-measure.min-width;

                                        for option[index] in root.launch-options: LaunchOptionToggle {
                                            width: launch-option-flow.cell-width;
                                            text: option.name;
                                            checked: option.checked;
                                            toggled(checked) => {
                                                root.toggle-launch-option(index, checked);
                                            }
                                        }
                                    }

                                    if !root.launch-argument-controls-visible || root.launch-options.length == 0 : Text {
                                        text: root.launch-options-empty-text;
                                        color: Theme.text-support;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }

                                    SmallLabel {
                                        label: "Extra arguments";
                                    }

                                    AppLineEdit {
                                        placeholder: "Extra arguments";
                                        value <=> root.custom-game-args;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;

                            SecondaryButton {
                                text: "Cancel";
                                enabled: root.launch-options-dirty;
                                clicked => {
                                    root.cancel-launch-options();
                                }
                            }

                            PrimaryButton {
                                text: root.launch-options-dirty ? "Save" : root.launch-options-save-text;
                                enabled: root.launch-options-dirty;
                                clicked => {
                                    root.save-launch-options();
                                }
                            }
                        }

                        reset-save-button := Timer {
                            interval: 2s;
                            running: root.launch-options-save-text != "Save";
                            triggered => {
                                root.launch-options-save-text = "Save";
                            }
                        }
                    }
                }

                if root.active-page == 2 : Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 8px;

                            TabButton {
                                text: "Dungeon Rampage Haxe";
                                active: root.version-history-page == 0;
                                clicked => {
                                    root.select-version-history-source(0);
                                }
                            }

                            TabButton {
                                text: "DRH Launcher";
                                active: root.version-history-page == 1;
                                clicked => {
                                    root.select-version-history-source(1);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;

                            Rectangle {
                                width: 240px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-muted;
                                background: Theme.panel-background;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;

                                    SmallLabel {
                                        label: root.version-history-page == 0 ? root.drh-version-list-label : root.launcher-version-list-label;
                                    }

                                    if root.version-history-loading || root.version-history-status != "" : Text {
                                        text: root.version-history-loading ? "Loading releases..." : root.version-history-status;
                                        color: root.version-history-loading ? Theme.text-muted : Theme.text-secondary;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    if root.version-history-page == 0 : ListView {
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;

                                        for version[index] in root.drh-version-entries: VersionEntryButton {
                                            title: version.title;
                                            detail: version.detail;
                                            status: version.status;
                                            active: root.selected-drh-version-index == index;
                                            clicked => {
                                                root.select-drh-version(index);
                                            }
                                        }
                                    }

                                    if root.version-history-page == 1 : ListView {
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;

                                        for version[index] in root.launcher-version-entries: VersionEntryButton {
                                            title: version.title;
                                            detail: version.detail;
                                            status: version.status;
                                            active: root.selected-launcher-version-index == index;
                                            clicked => {
                                                root.select-launcher-version(index);
                                            }
                                        }
                                    }
                                }
                            }

                            SettingsCard {
                                title: root.selected-version-title;
                                description: root.selected-version-detail;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;

                                if root.selected-version-release-enabled : Text {
                                    text: "Changelog preview may miss some GitHub formatting. Use the button below to see the original release notes.";
                                    color: Theme.text-support;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                ScrollView {
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    content-width: self.width;
                                    content-height: version-changelog-content.preferred-height;

                                    version-changelog-content := VerticalLayout {
                                        width: parent.width;
                                        spacing: 4px;

                                        for block in root.selected-version-changelog-blocks: MarkdownBlock {
                                            text: block.text;
                                            kind: block.kind;
                                            target: block.target;
                                            open-target(url) => {
                                                root.open-markdown-link(url);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: end;
                                    vertical-stretch: 0;

                                    SecondaryButton {
                                        text: "Open on GitHub";
                                        enabled: root.selected-version-release-enabled;
                                        clicked => {
                                            root.open-selected-version-release();
                                        }
                                    }

                                    if root.version-history-page == 0 : replace-version-button := SecondaryButton {
                                        text: root.selected-version-action-text;
                                        enabled: root.selected-version-action-enabled;
                                        active: root.selected-version-replace-confirmation-visible;
                                        clicked => {
                                            root.selected-version-replace-popover-anchor-x = replace-version-button.absolute-position.x + replace-version-button.width;
                                            root.selected-version-replace-popover-anchor-y = replace-version-button.absolute-position.y;
                                            root.install-selected-drh-version();
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            SecondaryButton {
                                text: "Refresh";
                                enabled: root.refresh-version-history-enabled;
                                clicked => {
                                    root.refresh-version-history();
                                }
                            }
                        }
                    }
                }

                if root.active-page == 3 : Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 8px;

                            TabButton {
                                text: root.mods-installed-tab-text;
                                active: root.mods-page == 0;
                                clicked => {
                                    root.select-mods-page(0);
                                }
                            }

                            TabButton {
                                text: "Catalog";
                                active: root.mods-page == 1;
                                clicked => {
                                    root.select-mods-page(1);
                                }
                            }

                            // The notice shown before mods are first used.
                            Rectangle {
                                width: about-mods-label.preferred-width + 8px;

                                about-mods-label := Text {
                                    text: "About mods";
                                    color: about-mods-touch.has-hover ? Theme.accent-warm : Theme.text-secondary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                about-mods-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.mods-disclosure-asking = false;
                                        root.mods-disclosure-visible = true;
                                    }
                                }
                            }
                        }

                        // The last action's failure; the log has all of it.
                        if root.mods-error != "" : Rectangle {
                            height: 50px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.accent-warm;
                            background: Theme.surface-selected;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: stretch;

                                Text {
                                    horizontal-stretch: 1;
                                    text: "⚠ " + root.mods-error;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    SecondaryButton {
                                        text: "Open logs";
                                        clicked => {
                                            root.log-source = 0;
                                            root.settings-page = 1;
                                            root.active-page = 4;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    StepperButton {
                                        text: "✕";
                                        clicked => {
                                            root.dismiss-mods-error();
                                        }
                                    }
                                }
                            }
                        }

                        if !root.mod-detail-open : HorizontalLayout {
                            spacing: 12px;

                            AppLineEdit {
                                placeholder: "Search name or GitHub account";
                                value <=> root.mod-search;
                                changed value => {
                                    root.mod-search-edited(self.value);
                                }
                            }

                            if root.mods-page == 1 : Text {
                                text: root.mods-index-status;
                                color: Theme.text-support;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        // How the last game went with the mods.
                        if !root.mod-detail-open && root.mods-page == 0 && root.mods-run-text != "" : Text {
                            text: (root.mods-run-warning ? "⚠ " : "") + root.mods-run-text;
                            color: root.mods-run-warning ? Theme.accent-warm : Theme.text-support;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        if !root.mod-detail-open && root.mod-entries.length == 0 : Text {
                            text: root.mod-list-empty-text;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        if !root.mod-detail-open && root.mods-page == 1 : ScrollView {
                            vertical-stretch: 1;
                            viewport-y <=> root.mod-list-scroll;
                            content-width: self.width;
                            content-height: mod-grid.height;

                            // Placed by hand: a FlexboxLayout sizes its rows
                            // from the cards' wrapped text, and they overlap.
                            mod-grid := Rectangle {
                                property <length> gap: 12px;
                                property <length> card-height: 112px;
                                property <int> columns: max(1, floor((self.width + self.gap) / (440px + self.gap)));
                                property <length> cell-width: (self.width - (self.columns - 1) * self.gap) / self.columns;

                                width: parent.width;
                                height: ceil(root.mod-entries.length / self.columns) * (self.card-height + self.gap);

                                for entry[index] in root.mod-entries: ModCard {
                                    x: Math.mod(index, mod-grid.columns) * (mod-grid.cell-width + mod-grid.gap);
                                    y: floor(index / mod-grid.columns) * (mod-grid.card-height + mod-grid.gap);
                                    width: mod-grid.cell-width;
                                    height: mod-grid.card-height;
                                    name: entry.name;
                                    summary: entry.summary;
                                    author: entry.author;
                                    owner: entry.owner;
                                    uses: entry.uses;
                                    tags: entry.tags;
                                    status: entry.status;
                                    clicked => {
                                        root.select-mod(index);
                                    }
                                    show-tooltip(text, x, y) => {
                                        root.show-mod-tooltip(text, x, y);
                                    }
                                    hide-tooltip => {
                                        root.info-tooltip-visible = false;
                                    }
                                }
                            }
                        }

                        if !root.mod-detail-open && root.mods-page == 0 : ScrollView {
                            vertical-stretch: 1;
                            viewport-y <=> root.mod-list-scroll;
                            content-width: self.width;
                            content-height: mod-rows.preferred-height;

                            mod-rows := VerticalLayout {
                                width: parent.width;
                                spacing: 8px;
                                alignment: start;

                                for entry[index] in root.mod-entries: ModRow {
                                    name: entry.name;
                                    version: entry.version;
                                    summary: entry.summary;
                                    uses: entry.uses;
                                    tags: entry.tags;
                                    status: entry.status;
                                    enabled: entry.enabled;
                                    orderable: entry.orderable;
                                    can-move-up: entry.can-move-up;
                                    can-move-down: entry.can-move-down;
                                    busy: root.mods-busy;
                                    show-tooltip(text, x, y) => {
                                        root.show-mod-tooltip(text, x, y);
                                    }
                                    hide-tooltip => {
                                        root.info-tooltip-visible = false;
                                    }
                                    clicked => {
                                        root.select-mod(index);
                                    }
                                    toggled => {
                                        root.toggle-mod(index);
                                    }
                                    moved(delta) => {
                                        root.move-mod(index, delta);
                                    }
                                }
                            }
                        }

                        if root.mod-detail-open : SettingsCard {
                            title: root.selected-mod-title;
                            description: root.selected-mod-description;
                            vertical-stretch: 1;

                            if root.selected-mod-tags.length > 0 : HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                for tag in root.selected-mod-tags: ModTag {
                                    tag: tag;
                                    show-tooltip(text, x, y) => {
                                        root.show-mod-tooltip(text, x, y);
                                    }
                                    hide-tooltip => {
                                        root.info-tooltip-visible = false;
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: 4px;

                                Text {
                                    text: "by";
                                    color: Theme.text-support;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                ModAuthor {
                                    author: root.selected-mod-author;
                                    owner: root.selected-mod-owner;
                                    font-size: 12px;
                                }
                            }

                            ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                viewport-y <=> root.mod-detail-scroll;
                                content-width: self.width;
                                content-height: mod-description-content.preferred-height;

                                mod-description-content := VerticalLayout {
                                    width: parent.width;
                                    spacing: 4px;

                                    for block in root.selected-mod-blocks: MarkdownBlock {
                                        text: block.text;
                                        kind: block.kind;
                                        target: block.target;
                                        open-target(url) => {
                                            root.open-markdown-link(url);
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                vertical-stretch: 0;

                                SecondaryButton {
                                    text: root.mods-page == 1 ? "← Catalog" : "← Installed";
                                    clicked => {
                                        root.mod-detail-open = false;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                if root.selected-mod-repository-enabled : GitHubButton {
                                    min-width: 142px;
                                    horizontal-stretch: 0;
                                    text: "Repository";
                                    clicked => {
                                        root.open-mod-repository();
                                    }
                                }

                                if root.selected-mod-uninstall-visible : SecondaryButton {
                                    text: "Uninstall";
                                    enabled: !root.mods-busy;
                                    clicked => {
                                        root.mod-uninstall();
                                    }
                                }

                                if root.selected-mod-update-text != "" : SecondaryButton {
                                    text: root.selected-mod-update-text;
                                    enabled: !root.mods-busy;
                                    clicked => {
                                        root.mod-update();
                                    }
                                }

                                SecondaryButton {
                                    text: root.selected-mod-primary-text;
                                    enabled: root.selected-mod-primary-enabled && !root.mods-busy;
                                    clicked => {
                                        root.mod-primary-action();
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            // For a mod the catalog does not have.
                            if !root.mod-detail-open : MenuButton {
                                horizontal-stretch: 1;
                                text: "More mods";
                                active: root.more-mods-open;
                                clicked => {
                                    root.more-mods-open = !root.more-mods-open;
                                }
                            }

                            SecondaryButton {
                                horizontal-stretch: 1;
                                text: "Open mods folder";
                                clicked => {
                                    root.open-mods-folder();
                                }
                            }

                            if root.mod-detail-open && root.selected-mod-folder-visible : SecondaryButton {
                                horizontal-stretch: 1;
                                text: "Open this mod's folder";
                                clicked => {
                                    root.open-mod-folder();
                                }
                            }

                            SecondaryButton {
                                horizontal-stretch: 1;
                                text: "Refresh";
                                enabled: !root.mods-busy;
                                clicked => {
                                    root.refresh-mods();
                                }
                            }
                        }
                    }

                    if root.more-mods-open : TouchArea {
                        clicked => {
                            root.more-mods-open = false;
                        }
                    }

                    // Above More mods, the first of the bottom buttons.
                    if root.more-mods-open : Rectangle {
                        x: 0px;
                        y: parent.height - 38px - 6px - self.height;
                        width: max((parent.width - 20px) / 3, 300px);
                        height: more-mods-items.preferred-height;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border-accent-muted;
                        background: Theme.surface-raised;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.shadow-strong;

                        more-mods-items := VerticalLayout {
                            padding: 6px;

                            for item[i] in [
                                "Install from a zip or a GitHub link…",
                                "Suggest a mod on Discord",
                                "Make your own mod",
                            ]: Rectangle {
                                height: 36px;
                                border-radius: 4px;
                                background: item-touch.has-hover ? Theme.surface-accent : transparent;

                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: item;
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }

                                item-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.more-mods-open = false;
                                        if (i == 0) {
                                            root.mod-elsewhere-link = "";
                                            root.mod-elsewhere-working = "";
                                            root.mod-elsewhere-error = "";
                                            root.mod-elsewhere-visible = true;
                                        } else if (i == 1) {
                                            root.open-discord-link();
                                        } else {
                                            root.open-mod-guide();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active-page == 4 : Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 8px;

                            TabButton {
                                text: "General";
                                active: root.settings-page == 0;
                                clicked => {
                                    root.settings-page = 0;
                                }
                            }

                            TabButton {
                                text: "Logs";
                                active: root.settings-page == 1;
                                clicked => {
                                    root.settings-page = 1;
                                }
                            }

                            TabButton {
                                text: "About";
                                active: root.settings-page == 2;
                                clicked => {
                                    root.settings-page = 2;
                                }
                            }
                        }

                        if root.settings-page == 0 : VerticalLayout {
                            spacing: 16px;
                            vertical-stretch: 1;

                            general-page-scroll := ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                content-width: self.width;
                                content-height: general-page-content.preferred-height;

                                general-page-content := VerticalLayout {
                                    width: general-page-scroll.width;
                                    spacing: 12px;

                                    if root.linux-integration-visible && !root.linux-integration-advanced : SettingsCard {
                                        title: "Application";
                                        description: root.linux-integration-status;

                                        Text {
                                            text: root.linux-integration-path;
                                            font-size: 13px;
                                            color: Theme.text-body;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            SecondaryButton {
                                                text: "Open folder";
                                                enabled: root.open-linux-integration-folder-enabled;
                                                clicked => {
                                                    root.open-linux-integration-folder();
                                                }
                                            }

                                            SecondaryButton {
                                                text: root.linux-integration-action-text;
                                                enabled: root.linux-integration-action-enabled;
                                                clicked => {
                                                    root.linux-integration-action();
                                                }
                                            }
                                        }
                                    }

                                    SettingsCard {
                                        title: "Storage";
                                        description: "Location used for managed data, downloaded archives, logs, and Dungeon Rampage Haxe.";

                                        Text {
                                            text: root.install-folder-path;
                                            font-size: 13px;
                                            color: Theme.text-body;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            SecondaryButton {
                                                text: "Open folder";
                                                enabled: root.open-install-folder-enabled;
                                                clicked => {
                                                    root.open-install-folder();
                                                }
                                            }
                                        }
                                    }

                                    SettingsCard {
                                        title: "Official Dungeon Rampage notice";
                                        description: "You need to own the official Dungeon Rampage to play DRH. You don't need to install it, but if it isn't found in this Steam library, Home can show a reminder just in case.";

                                        LaunchOptionToggle {
                                            text: "Show this notice on Home";
                                            checked: !root.hide-official-ownership-notice;
                                            toggled(checked) => {
                                                root.hide-official-ownership-notice = !checked;
                                            }
                                        }
                                    }

                                    SettingsCard {
                                        title: "Download cache";
                                        description: "Keeps this many verified release archives in data/downloads. Cached archives can speed up reinstalls, repairs, and rollbacks, but use disk space. Set 0 to avoid keeping completed archives.";

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            StepperButton {
                                                text: "-";
                                                clicked => {
                                                    root.decrement-download-cache-limit();
                                                }
                                            }

                                            NumericTextField {
                                                value <=> root.download-cache-limit;
                                            }

                                            StepperButton {
                                                text: "+";
                                                clicked => {
                                                    root.increment-download-cache-limit();
                                                }
                                            }
                                        }

                                        if root.download-cache-limit-error != "" : Text {
                                            text: root.download-cache-limit-error;
                                            font-size: 13px;
                                            color: Theme.accent-primary-hover;
                                            wrap: word-wrap;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 8px;

                                        SecondaryButton {
                                            text: root.advanced-settings-open ? "Hide advanced settings" : "Advanced settings";
                                            clicked => {
                                                root.advanced-settings-open = !root.advanced-settings-open;
                                            }
                                        }

                                        if root.advanced-settings-open : SettingsCard {
                                            title: "Config file";
                                            description: "Manual edits are usually not needed. Use this only for diagnostics or unsupported changes.";

                                            Text {
                                                text: root.config-path;
                                                font-size: 13px;
                                                color: Theme.text-body;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                SecondaryButton {
                                                    text: "Open config folder";
                                                    clicked => {
                                                        root.open-config-folder();
                                                    }
                                                }
                                            }
                                        }

                                        if root.advanced-settings-open && root.linux-integration-visible && root.linux-integration-advanced : SettingsCard {
                                            title: "Application";
                                            description: root.linux-integration-status;

                                            Text {
                                                text: root.linux-integration-path;
                                                font-size: 13px;
                                                color: Theme.text-body;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;

                                                SecondaryButton {
                                                    text: "Open folder";
                                                    enabled: root.open-linux-integration-folder-enabled;
                                                    clicked => {
                                                        root.open-linux-integration-folder();
                                                    }
                                                }

                                                SecondaryButton {
                                                    text: root.linux-integration-action-text;
                                                    enabled: root.linux-integration-action-enabled;
                                                    clicked => {
                                                        root.linux-integration-action();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                alignment: end;

                                SecondaryButton {
                                    text: "Cancel";
                                    enabled: root.general-settings-dirty;
                                    clicked => {
                                        root.cancel-general-settings();
                                    }
                                }

                                PrimaryButton {
                                    text: root.general-settings-dirty ? "Save" : root.download-cache-save-text;
                                    enabled: root.general-settings-dirty;
                                    clicked => {
                                        root.save-general-settings();
                                    }
                                }
                            }
                        }

                        if root.settings-page == 1 : VerticalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;

                                TabButton {
                                    text: "Launcher";
                                    active: root.log-source == 0;
                                    clicked => {
                                        root.select-log-source(0);
                                    }
                                }

                                TabButton {
                                    text: "Game sessions";
                                    active: root.log-source == 1;
                                    clicked => {
                                        root.select-log-source(1);
                                    }
                                }
                            }

                            if root.game-log-migration-status != "" : Text {
                                text: root.game-log-migration-status;
                                color: Theme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            if root.log-source == 0 : LogViewer {
                                title: root.launcher-log-title;
                                meta: root.log-meta;
                                lines: root.log-lines;
                                default-scroll-to-end: true;
                                saved-position-known: root.launcher-log-position-known;
                                saved-content-y: root.launcher-log-content-y;
                                saved-at-end: root.launcher-log-at-end;
                                position-key: 0;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                wrap-columns-measured(columns) => {
                                    root.log-wrap-columns-measured(0, columns);
                                }
                                content-position-changed(position, at-end) => {
                                    root.launcher-log-content-y = position;
                                    root.launcher-log-at-end = at-end;
                                    root.launcher-log-position-known = true;
                                }
                                copy-requested(a-line, a-col, c-line, c-col) => {
                                    return root.copy-log-selection(a-line, a-col, c-line, c-col);
                                }
                            }

                            if root.log-source == 1 : HorizontalLayout {
                                spacing: 12px;
                                vertical-stretch: 1;

                                Rectangle {
                                    width: 200px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border-muted;
                                    background: Theme.panel-background;

                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 8px;

                                        SmallLabel {
                                            label: root.game-log-sessions-label;
                                        }

                                        session-list := ListView {
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;

                                            for session[index] in root.game-log-sessions: GameSessionButton {
                                                title: session.title;
                                                detail: session.detail;
                                                active: root.selected-game-log-index == index;
                                                clicked => {
                                                    root.select-game-log(index);
                                                }
                                            }
                                        }
                                    }
                                }

                                LogViewer {
                                    title: root.selected-game-log-title;
                                    meta: root.log-meta;
                                    show-display-settings: true;
                                    hide-haxe-iteratee-log-lines: root.hide-haxe-iteratee-log-lines;
                                    lines: root.log-lines;
                                    default-scroll-to-end: false;
                                    saved-position-known: root.game-log-position-known;
                                    saved-content-y: root.game-log-content-y;
                                    saved-at-end: root.game-log-at-end;
                                    position-key: root.selected-game-log-index;
                                    horizontal-stretch: 1;
                                    vertical-stretch: 1;
                                    wrap-columns-measured(columns) => {
                                        root.log-wrap-columns-measured(1, columns);
                                    }
                                    content-position-changed(position, at-end) => {
                                        root.game-log-content-y = position;
                                        root.game-log-at-end = at-end;
                                        root.game-log-position-known = true;
                                    }
                                    copy-requested(a-line, a-col, c-line, c-col) => {
                                        return root.copy-log-selection(a-line, a-col, c-line, c-col);
                                    }
                                    set-hide-haxe-iteratee-log-lines(hide) => {
                                        root.set-hide-haxe-iteratee-log-lines(hide);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                SecondaryButton {
                                    horizontal-stretch: 1;
                                    text: "Open logs folder";
                                    enabled: root.open-logs-folder-enabled;
                                    clicked => {
                                        root.open-logs-folder();
                                    }
                                }

                                if root.log-source == 1 : SecondaryButton {
                                    horizontal-stretch: 1;
                                    text: "Open selected file";
                                    enabled: root.selected-game-log-enabled;
                                    clicked => {
                                        root.open-selected-game-log();
                                    }
                                }

                                SecondaryButton {
                                    horizontal-stretch: 1;
                                    text: "Refresh";
                                    enabled: root.open-logs-folder-enabled && root.refresh-logs-enabled;
                                    clicked => {
                                        root.refresh-logs();
                                    }
                                }
                            }

                        }

                        if root.settings-page == 2 : VerticalLayout {
                            spacing: 16px;
                            vertical-stretch: 1;

                            about-page-scroll := ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                content-width: self.width;
                                content-height: about-page-content.preferred-height;

                                about-page-content := VerticalLayout {
                                    width: about-page-scroll.width;
                                    spacing: 12px;

                                    SettingsCard {
                                        title: "Dungeon Rampage Haxe";
                                        description: "A Haxe & OpenFL port of Dungeon Rampage, intended as a higher-performance, responsive version of the original game, for a smoother experience.";

                                        SmallLabel {
                                            label: "Technologies";
                                        }

                                        Text {
                                            text: "Haxe, ax4, and forks of OpenFL, Lime, libhxcpp, SWF, SteamWrap and hxScript. ax4 is my ActionScript 3 to Haxe converter; it also provides DRH's runtime compatibility layer.";
                                            font-size: 13px;
                                            color: Theme.text-body;
                                            wrap: word-wrap;
                                        }
                                    }

                                    SettingsCard {
                                        title: "DRH Launcher";
                                        description: "The recommended way to install, update, configure, and play Dungeon Rampage Haxe.";

                                        drhl-metrics := EqualColumnFlow {
                                            cell-min-width: max(version-metric.min-width, technologies-metric.min-width, license-metric.min-width);
                                            max-columns: 3;
                                            spacing: 6px;

                                            version-metric := CompactMetricBlock {
                                                width: drhl-metrics.cell-width;
                                                label: "Version";
                                                value: root.launcher-version;
                                            }

                                            technologies-metric := CompactMetricBlock {
                                                width: drhl-metrics.cell-width;
                                                label: "Technologies";
                                                value: "Rust and Slint";
                                            }

                                            license-metric := CompactMetricBlock {
                                                width: drhl-metrics.cell-width;
                                                label: "License";
                                                value: "GPL-3.0-or-later";
                                            }
                                        }
                                    }

                                    SettingsCard {
                                        title: "Project and rights";
                                        description: "DRH, DRH Launcher and ax4 are maintained by Tutez and developed with public source repositories.";

                                        Text {
                                            text: "DRH Launcher and ax4 are free software under GPL-3.0-or-later and MIT respectively. Original code and modifications created by DRH contributors are also licensed under GPL-3.0-or-later, to the extent that they hold the necessary rights. Material originating from Dungeon Rampage and other third-party components remain governed by their respective rights and licenses.";
                                            font-size: 13px;
                                            color: Theme.text-body;
                                            wrap: word-wrap;
                                        }
                                    }

                                    SettingsCard {
                                        title: "Links";
                                        description: "Community and source repositories. If you appreciate my work, starring the GitHub repositories helps support the projects.";

                                        link-buttons := EqualColumnFlow {
                                            cell-min-width: max(discord-link.min-width, drh-link.min-width, drhl-link.min-width, ax4-link.min-width);
                                            spacing: 10px;

                                            discord-link := LinkButton {
                                                width: link-buttons.cell-width;
                                                text: "Discord";
                                                icon-kind: 0;
                                                clicked => {
                                                    root.open-discord-link();
                                                }
                                            }

                                            drh-link := LinkButton {
                                                width: link-buttons.cell-width;
                                                text: "DRH GitHub";
                                                icon-kind: 1;
                                                clicked => {
                                                    root.open-drh-github-link();
                                                }
                                            }

                                            drhl-link := LinkButton {
                                                width: link-buttons.cell-width;
                                                text: "DRHL GitHub";
                                                icon-kind: 1;
                                                clicked => {
                                                    root.open-drhl-github-link();
                                                }
                                            }

                                            ax4-link := LinkButton {
                                                width: link-buttons.cell-width;
                                                text: "ax4 GitHub";
                                                icon-kind: 1;
                                                clicked => {
                                                    root.open-ax4-github-link();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    reset-cache-save-button := Timer {
        interval: 2s;
        running: root.download-cache-save-text != "Save" && !root.download-cache-limit-dirty;
        triggered => {
            root.download-cache-save-text = "Save";
        }
    }

    // A hidden copy of the launch-option toggles: its width is the widest
    // toggle's, which the visible ones share (see EqualColumnFlow). The explicit
    // position keeps its size constraints out of the window's: without it, the
    // window could not grow taller than the stacked toggles.
    Rectangle {
        x: 0px;
        y: 0px;
        visible: false;

        launch-option-measure := VerticalLayout {
            for option in root.launch-options: LaunchOptionToggle {
                text: option.name;
            }
        }
    }

    info-tooltip-measure := Text {
        visible: false;
        text: root.info-tooltip-text;
        font-size: 12px;
        wrap: no-wrap;
    }

    Rectangle {
        z: 1000;
        visible: root.info-tooltip-visible;
        width: min(info-tooltip-measure.preferred-width + 20px, root.info-tooltip-width, root.width - 16px);
        height: info-tooltip-text.preferred-height + 16px;
        x: root.info-tooltip-place-above
            ? min(max(root.info-tooltip-anchor-x - self.width / 2, 8px), root.width - self.width - 8px)
            : root.info-tooltip-place-left
                ? min(max(root.info-tooltip-anchor-x - self.width - 8px, 8px), root.width - self.width - 8px)
                : min(max(root.info-tooltip-anchor-x + 24px, 8px), root.width - self.width - 8px);
        y: root.info-tooltip-place-above
            ? max(root.info-tooltip-anchor-y - self.height - 8px, 8px)
            : root.info-tooltip-place-left
                ? min(max(root.info-tooltip-anchor-y - self.height / 2, 8px), root.height - self.height - 8px)
                : max(root.info-tooltip-anchor-y - self.height, 8px);
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border-accent-muted;
        background: Theme.surface-raised;

        info-tooltip-text := Text {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: root.info-tooltip-text;
            color: Theme.text-body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    if root.selected-version-replace-confirmation-visible : Rectangle {
        z: 1500;
        background: transparent;

        TouchArea {
            clicked => {
                root.cancel-selected-drh-version-install();
            }
        }

        Rectangle {
            z: 1501;
            width: min(440px, parent.width - 24px);
            property <length> popover-padding: 14px;
            property <length> popover-spacing: 12px;
            property <length> popover-button-height: 38px;
            height: self.popover-padding * 2
                + replace-popover-title.preferred-height
                + self.popover-spacing
                + replace-popover-message.preferred-height
                + self.popover-spacing
                + self.popover-button-height;
            x: min(max(root.selected-version-replace-popover-anchor-x - self.width, 8px), parent.width - self.width - 8px);
            y: min(max(root.selected-version-replace-popover-anchor-y - self.height - 10px, 8px), parent.height - self.height - 8px);
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            replace-popover-title := Text {
                x: parent.popover-padding;
                y: parent.popover-padding;
                width: parent.width - parent.popover-padding * 2;
                text: "Replace installed version?";
                color: Theme.text-title;
                font-size: 14px;
                font-weight: 800;
            }

            replace-popover-message := Text {
                x: parent.popover-padding;
                y: replace-popover-title.y + replace-popover-title.preferred-height + parent.popover-spacing;
                width: parent.width - parent.popover-padding * 2;
                height: self.preferred-height;
                text: root.selected-version-replace-confirmation-text;
                color: Theme.text-body;
                font-size: 13px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                x: parent.popover-padding;
                y: replace-popover-message.y + replace-popover-message.preferred-height + parent.popover-spacing;
                width: parent.width - parent.popover-padding * 2;
                height: parent.popover-button-height;
                spacing: 10px;
                alignment: end;

                SecondaryButton {
                    width: (parent.width - 10px) / 2;
                    height: parent.height;
                    text: "Cancel";
                    clicked => {
                        root.cancel-selected-drh-version-install();
                    }
                }

                SecondaryButton {
                    width: (parent.width - 10px) / 2;
                    height: parent.height;
                    text: "Confirm";
                    enabled: root.selected-version-action-enabled;
                    clicked => {
                        root.install-selected-drh-version();
                    }
                }
            }
        }
    }

    if root.mods-disclosure-visible : Rectangle {
        z: 2000;
        background: Theme.modal-scrim;

        TouchArea {}

        Rectangle {
            width: min(600px, parent.width - 32px);
            height: mods-disclosure-content.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            mods-disclosure-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 12px;

                Text {
                    text: "Before you play with mods";
                    color: Theme.text-title;
                    font-size: 19px;
                    font-weight: 800;
                }

                for point in [
                    "A mod is code that runs inside the game, with its access to your computer. Mods in the catalog are open source, one click from their page, and are reviewed by hand, which is no guarantee; mods installed from elsewhere are not reviewed at all.",
                    "You play on the same servers as with DRH alone. No one can promise anything about bans, either way.",
                    "A DRH update can break a mod, and some mods may not work together.",
                    "To play without mods, disable them: the game's files are never changed.",
                    "Like DRH, mods are not made or endorsed by Dungeon Rampage's rights holders.",
                ]: Text {
                    text: "• " + point;
                    color: Theme.text-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    min-height: 42px;
                    spacing: 10px;
                    alignment: end;

                    if root.mods-disclosure-asking : SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            root.mods-disclosure-close();
                        }
                    }

                    if root.mods-disclosure-asking : PrimaryButton {
                        text: "Continue";
                        clicked => {
                            root.mods-disclosure-continue();
                        }
                    }

                    if !root.mods-disclosure-asking : SecondaryButton {
                        text: "Close";
                        clicked => {
                            root.mods-disclosure-close();
                        }
                    }
                }
            }
        }
    }

    if root.mod-elsewhere-visible : Rectangle {
        z: 2000;
        background: Theme.modal-scrim;

        TouchArea {}

        Rectangle {
            width: min(560px, parent.width - 32px);
            height: mod-elsewhere-content.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            mod-elsewhere-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 16px;

                Text {
                    text: "Install a mod from elsewhere";
                    color: Theme.text-title;
                    font-size: 19px;
                    font-weight: 800;
                    wrap: word-wrap;
                }

                Text {
                    text: "No one reviews a mod installed this way: only install one you trust.";
                    color: Theme.text-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "From the latest release of its GitHub repository:";
                        color: Theme.text-support;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        AppLineEdit {
                            placeholder: "https://github.com/owner/DRH-Mod-Name";
                            enabled: root.mod-elsewhere-working == "";
                            value <=> root.mod-elsewhere-link;
                        }

                        SecondaryButton {
                            text: "Install";
                            enabled: root.mod-elsewhere-working == "" && root.mod-elsewhere-link != "";
                            clicked => {
                                root.mod-install-from-link(root.mod-elsewhere-link);
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Or from a zip on this computer:";
                        color: Theme.text-support;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;

                        SecondaryButton {
                            text: "Choose a zip…";
                            enabled: root.mod-elsewhere-working == "";
                            clicked => {
                                root.mod-install-from-zip();
                            }
                        }
                    }
                }

                if root.mod-elsewhere-working != "" : Text {
                    text: root.mod-elsewhere-working;
                    color: Theme.text-support;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                if root.mod-elsewhere-error != "" : Text {
                    text: "⚠ " + root.mod-elsewhere-error;
                    color: Theme.accent-warm;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    min-height: 42px;
                    alignment: end;

                    SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            root.mod-elsewhere-cancelled();
                        }
                    }
                }
            }
        }
    }

    if root.mod-confirm-visible : Rectangle {
        z: 2000;
        background: Theme.modal-scrim;

        TouchArea {}

        Rectangle {
            width: min(560px, parent.width - 32px);
            height: mod-confirm-content.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            mod-confirm-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 16px;

                Text {
                    text: root.mod-confirm-title;
                    color: Theme.text-title;
                    font-size: 19px;
                    font-weight: 800;
                    wrap: word-wrap;
                }

                Text {
                    text: root.mod-confirm-text;
                    color: Theme.text-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    min-height: 42px;
                    spacing: 10px;
                    alignment: end;

                    SecondaryButton {
                        text: "Cancel";
                        clicked => {
                            root.mod-confirm-cancelled();
                        }
                    }

                    PrimaryButton {
                        text: root.mod-confirm-button;
                        clicked => {
                            root.mod-confirm-accepted();
                        }
                    }
                }
            }
        }
    }

    if root.close-confirmation-visible : Rectangle {
        z: 2000;
        background: Theme.modal-scrim;

        TouchArea {}

        Rectangle {
            width: min(500px, parent.width - 32px);
            height: close-dialog-content.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            close-dialog-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 16px;

                Text {
                    text: "Quit DRH Launcher?";
                    color: Theme.text-title;
                    font-size: 19px;
                    font-weight: 800;
                }

                Text {
                    text: "Dungeon Rampage Haxe is still running. DRHL will stop the game, then quit.";
                    color: Theme.text-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                if root.close-confirmation-error != "" : Text {
                    text: root.close-confirmation-error;
                    color: Theme.accent-warm;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    min-height: 42px;
                    spacing: 10px;
                    alignment: end;

                    SecondaryButton {
                        text: "Cancel";
                        enabled: !root.close-confirmation-busy;
                        clicked => {
                            root.cancel-close();
                        }
                    }

                    PrimaryButton {
                        text: root.close-confirmation-busy ? "Stopping DRH..." : "Stop DRH and quit";
                        enabled: !root.close-confirmation-busy;
                        clicked => {
                            root.confirm-close();
                        }
                    }
                }
            }
        }
    }

    if root.appimage-dialog-visible : Rectangle {
        z: 2100;
        background: Theme.modal-scrim;

        TouchArea {}

        Rectangle {
            width: min(520px, parent.width - 32px);
            height: appimage-dialog-content.preferred-height + 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-accent-muted;
            background: Theme.surface-raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow-strong;

            appimage-dialog-content := VerticalLayout {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                height: parent.height - 48px;
                spacing: 16px;

                Text {
                    text: root.appimage-dialog-mode == 2
                        ? "Uninstall DRH Launcher?"
                        : "Install DRH Launcher?";
                    color: Theme.text-title;
                    font-size: 19px;
                    font-weight: 800;
                }

                Text {
                    text: root.appimage-dialog-mode == 2
                        ? "This removes the AppImage and its application-menu entry. Dungeon Rampage Haxe, downloads, settings, and logs are kept."
                        : "DRH Launcher will install itself for your Linux user, add an application-menu entry, and restart.";
                    color: Theme.text-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                if root.appimage-dialog-error != "" : Text {
                    text: root.appimage-dialog-error;
                    color: Theme.accent-warm;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    min-height: 42px;
                    spacing: 10px;
                    alignment: end;

                    SecondaryButton {
                        text: root.appimage-dialog-mode == 2 ? "Cancel" : "Not now";
                        enabled: !root.appimage-dialog-busy;
                        clicked => {
                            root.cancel-appimage-dialog();
                        }
                    }

                    PrimaryButton {
                        text: root.appimage-dialog-busy
                            ? (root.appimage-dialog-mode == 2 ? "Uninstalling..." : "Installing...")
                            : (root.appimage-dialog-mode == 2 ? "Uninstall" : "Install");
                        enabled: !root.appimage-dialog-busy;
                        clicked => {
                            root.confirm-appimage-action();
                        }
                    }
                }
            }
        }
    }
}
